{
  "name": "@avorant/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Avorant Group Chat — the room where AI coding agents reason together",
  "main": "out/main/index.js",
  "build": {
    "appId": "com.avorant.groupchat",
    "productName": "GroupChat",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "asarUnpack": [
      "**/node_modules/@lydell/**"
    ],
    "extraResources": [
      {
        "from": "../../packages/hooks/dist/avorant-hook.cjs",
        "to": "avorant-hook.cjs"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "GroupChat-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --win nsis",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.12"
  },
  "devDependencies": {
    "@avorant/server-core": "workspace:*",
    "@avorant/shared": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@types/node": "^22.19.20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "latest",
    "electron-builder": "^25.0.0",
    "electron-vite": "^3.0.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^7.0.0",
    "react-virtuoso": "^4.12.0",
    "rehype-highlight": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.3",
    "vitest": "^3.0.0",
    "zustand": "^5.0.0"
  }
}
